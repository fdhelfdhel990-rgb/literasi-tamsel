APP_NAME="Komunitas Literasi Tamsel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
LOG_CHANNEL=stack
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=literasi_pad
DB_USERNAME=root
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=

# Optional read-only connectivity check for Aiven MySQL.
# Keep DB_CONNECTION=mysql for XAMPP/local development unless you intentionally switch.
AIVEN_DB_HOST=
AIVEN_DB_PORT=3306
AIVEN_DB_DATABASE=
AIVEN_DB_USERNAME=
AIVEN_DB_PASSWORD=
AIVEN_MYSQL_ATTR_SSL_CA=
AIVEN_DB_TIMEOUT=10

SESSION_DRIVER=database
CACHE_STORE=array
QUEUE_CONNECTION=sync
FRONTEND_DATA_SOURCE=database
FILESYSTEM_DISK=public
VITE_APP_NAME="Komunitas Literasi Tamsel"
ENABLE_ADMIN_DEMO=false
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_VISIBILITY=public

# Cloudflare R2 S3-compatible storage. Use FILESYSTEM_DISK=r2 in production.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=true
R2_HTTP_CA_BUNDLE=
